[Unit]
Description=Disk Repartitioning Service
Documentation=man:systemd-repart.service(8)
DefaultDependencies=no
Wants=modprobe@loop.service modprobe@dm_mod.service
After=modprobe@loop.service modprobe@dm_mod.service systemd-tpm2-setup-early.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
ExecStart=systemd-repart

# /etc/systemd/system/systemd-repart@.service.d/10-cubie-a7a-no-discard.conf
# Radxa Cubie A7A (fedora/mkdevcard.sh): the unpartitioned gap in front of
# the first partition holds the boot firmware, so systemd-repart must not
# discard it. The unit's own command line, plus --discard=no.
[Service]
ExecStart=
ExecStart=systemd-repart --discard=no
